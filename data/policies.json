  {
    "id": "hnte-bj-2026",
    "family": "hnte",
    "name": "高新技术企业认定",
    "region": "北京市",
    "year": 2026,
    "version": "北京申报季 2026",
    "state": "current",
    "description": "人员、研发投入与高新收入的跨年度证据核验",
    "published": "2026-04-28",
    "start": "2026-04-28",
    "deadlines": [
      "2026-05-15",
      "2026-07-17",
      "2026-09-24"
    ],
    "source": {
      "id": "bj-hnte-2026",
      "title": "关于启动2026年度北京市高新技术企业认定管理工作的通知",
      "url": "https://kw.beijing.gov.cn/zwgk/zcwj/202604/t20260428_4620918.html",
      "published": "2026-04-28",
      "authority": "北京市科委、中关村管委会等"
    },
    "scope_note": "第一版支持完整三个会计年度的数量指标。经营期不足三年转人工；创新能力评分、知识产权核心关联和领域判断不由程序代替专家认定。",
    "manual_checks": [
      "专家评价创新能力及知识产权对主要产品的核心支持作用",
      "核验高新技术领域归属、专项审计及告知承诺材料",
      "核实经营期不足三年、新成立企业和重新认定等特殊情况"
    ],
    "rules": [
      {
        "id": "region",
        "title": "北京属地",
        "fields": [
          "city"
        ],
        "op": "eq",
        "source": {
          "id": "bj-hnte-2026",
          "title": "关于启动2026年度北京市高新技术企业认定管理工作的通知",
          "url": "https://kw.beijing.gov.cn/zwgk/zcwj/202604/t20260428_4620918.html",
          "published": "2026-04-28",
          "authority": "北京市科委、中关村管委会等"
        },
        "clause": "二、申报企业范围",
        "quote": "在本市行政区域内注册的居民企业，且符合《认定办法》第十一条有关规定。",
        "expected": "北京市"
      },
      {
        "id": "resident",
        "title": "居民企业身份",
        "fields": [
          "resident_enterprise"
        ],
        "op": "eq",
        "source": {
          "id": "bj-hnte-2026",
          "title": "关于启动2026年度北京市高新技术企业认定管理工作的通知",
          "url": "https://kw.beijing.gov.cn/zwgk/zcwj/202604/t20260428_4620918.html",
          "published": "2026-04-28",
          "authority": "北京市科委、中关村管委会等"
        },
        "clause": "二、申报企业范围",
        "quote": "在本市行政区域内注册的居民企业。",
        "expected": true
      },
      {
        "id": "age",
        "title": "注册成立满一年",
        "fields": [
          "registration_date"
        ],
        "op": "age",
        "source": {
          "id": "national-hnte",
          "title": "高新技术企业认定管理办法（国科发火〔2016〕32号）",
          "url": "https://www.beijing.gov.cn/zhengce/zhengcefagui/202202/t20220222_2614690.html",
          "published": "2016-01-29",
          "authority": "科技部、财政部、国家税务总局；北京市政府转载"
        },
        "clause": "第十一条（一）",
        "quote": "企业申请认定时须注册成立一年以上。"
      },
      {
        "id": "ip",
        "title": "核心知识产权所有权",
        "fields": [
          "core_ip"
        ],
        "op": "eq",
        "source": {
          "id": "national-hnte",
          "title": "高新技术企业认定管理办法（国科发火〔2016〕32号）",
          "url": "https://www.beijing.gov.cn/zhengce/zhengcefagui/202202/t20220222_2614690.html",
          "published": "2016-01-29",
          "authority": "科技部、财政部、国家税务总局；北京市政府转载"
        },
        "clause": "第十一条（二）",
        "quote": "获得对其主要产品（服务）在技术上发挥核心支持作用的知识产权的所有权。",
        "expected": true
      },
      {
        "id": "domain",
        "title": "高新技术领域归属",
        "fields": [
          "supported_domain"
        ],
        "op": "eq",
        "source": {
          "id": "national-hnte",
          "title": "高新技术企业认定管理办法（国科发火〔2016〕32号）",
          "url": "https://www.beijing.gov.cn/zhengce/zhengcefagui/202202/t20220222_2614690.html",
          "published": "2016-01-29",
          "authority": "科技部、财政部、国家税务总局；北京市政府转载"
        },
        "clause": "第十一条（三）",
        "quote": "发挥核心支持作用的技术属于《国家重点支持的高新技术领域》规定的范围。",
        "expected": true
      },
      {
        "id": "staff_ratio",
        "title": "科技人员比例不低于 10%",
        "fields": [
          "tech_staff",
          "employees"
        ],
        "op": "ratio",
        "source": {
          "id": "national-hnte",
          "title": "高新技术企业认定管理办法（国科发火〔2016〕32号）",
          "url": "https://www.beijing.gov.cn/zhengce/zhengcefagui/202202/t20220222_2614690.html",
          "published": "2016-01-29",
          "authority": "科技部、财政部、国家税务总局；北京市政府转载"
        },
        "clause": "第十一条（四）",
        "quote": "科技人员占企业当年职工总数的比例不低于10%。",
        "threshold": 0.1,
        "period": "2025",
        "unit": "人"
      },
      {
        "id": "rd_ratio",
        "title": "近三年研发费用比例",
        "fields": [
          "sales_2023",
          "sales_2024",
          "sales_2025",
          "rd_2023",
          "rd_2024",
          "rd_2025",
          "registration_date"
        ],
        "op": "rd_ratio",
        "source": {
          "id": "national-hnte",
          "title": "高新技术企业认定管理办法（国科发火〔2016〕32号）",
          "url": "https://www.beijing.gov.cn/zhengce/zhengcefagui/202202/t20220222_2614690.html",
          "published": "2016-01-29",
          "authority": "科技部、财政部、国家税务总局；北京市政府转载"
        },
        "clause": "第十一条（五）",
        "quote": "近三个会计年度的研发费用总额占同期销售收入总额的比例：最近一年销售收入5000万元（含）以下不低于5%；5000万元至2亿元（含）不低于4%；2亿元以上不低于3%。",
        "unit": "万元"
      },
      {
        "id": "domestic",
        "title": "境内研发费用比例不低于 60%",
        "fields": [
          "domestic_rd_2023",
          "domestic_rd_2024",
          "domestic_rd_2025",
          "rd_2023",
          "rd_2024",
          "rd_2025",
          "registration_date"
        ],
        "op": "domestic_ratio",
        "source": {
          "id": "national-hnte",
          "title": "高新技术企业认定管理办法（国科发火〔2016〕32号）",
          "url": "https://www.beijing.gov.cn/zhengce/zhengcefagui/202202/t20220222_2614690.html",
          "published": "2016-01-29",
          "authority": "科技部、财政部、国家税务总局；北京市政府转载"
        },
        "clause": "第十一条（五）",
        "quote": "企业在中国境内发生的研究开发费用总额占全部研究开发费用总额的比例不低于60%。",
        "unit": "万元"
      },
      {
        "id": "hightech",
        "title": "高新收入比例不低于 60%",
        "fields": [
          "hightech_income_2025",
          "total_income_2025"
        ],
        "op": "ratio",
        "source": {
          "id": "national-hnte",
          "title": "高新技术企业认定管理办法（国科发火〔2016〕32号）",
          "url": "https://www.beijing.gov.cn/zhengce/zhengcefagui/202202/t20220222_2614690.html",
          "published": "2016-01-29",
          "authority": "科技部、财政部、国家税务总局；北京市政府转载"
        },
        "clause": "第十一条（六）",
        "quote": "近一年高新技术产品（服务）收入占企业同期总收入的比例不低于60%。",
        "threshold": 0.6,
        "period": "2025",
        "unit": "万元"
      },
      {
        "id": "integrity",
        "title": "申请前一年重大事故条件",
        "fields": [
          "hnte_compliance"
        ],
        "op": "eq",
        "source": {
          "id": "national-hnte",
          "title": "高新技术企业认定管理办法（国科发火〔2016〕32号）",
          "url": "https://www.beijing.gov.cn/zhengce/zhengcefagui/202202/t20220222_2614690.html",
          "published": "2016-01-29",
          "authority": "科技部、财政部、国家税务总局；北京市政府转载"
        },
        "clause": "第十一条（八）",
        "quote": "企业申请认定前一年内未发生重大安全、重大质量事故或严重环境违法行为。",
        "expected": true,
        "period": "申请前一年"
      }
    ]
  },
