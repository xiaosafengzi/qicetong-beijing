        },
        "clause": "第六条（一）",
        "quote": "在中国境内（不包括港、澳、台地区）注册的居民企业。",
        "expected": true
      },
      {
        "id": "staff",
        "title": "职工总数不超过 500 人",
        "fields": [
          "employees"
        ],
        "op": "lte",
        "source": {
          "id": "national-sme",
          "title": "科技型中小企业评价办法（国科发政〔2017〕115号）",
          "url": "https://most.gov.cn/xxgk/xinxifenlei/fdzdgknr/fgzc/gfxwj/gfxwj2017/201705/t20170510_132709.html",
          "published": "2017-05-03",
          "authority": "科技部、财政部、国家税务总局"
        },
        "clause": "第六条（二）",
        "quote": "职工总数不超过500人、年销售收入不超过2亿元、资产总额不超过2亿元。",
        "threshold": 500,
        "unit": "人",
        "period": "2025"
      },
      {
        "id": "sales",
        "title": "年销售收入不超过 2 亿元",
        "fields": [
          "sales_2025"
        ],
        "op": "lte",
        "source": {
          "id": "national-sme",
          "title": "科技型中小企业评价办法（国科发政〔2017〕115号）",
          "url": "https://most.gov.cn/xxgk/xinxifenlei/fdzdgknr/fgzc/gfxwj/gfxwj2017/201705/t20170510_132709.html",
          "published": "2017-05-03",
          "authority": "科技部、财政部、国家税务总局"
        },
        "clause": "第六条（二）",
        "quote": "年销售收入不超过2亿元。",
        "threshold": 20000,
        "unit": "万元",
        "period": "2025"
      },
      {
        "id": "assets",
        "title": "资产总额不超过 2 亿元",
        "fields": [
          "assets_2025"
        ],
        "op": "lte",
        "source": {
          "id": "national-sme",
          "title": "科技型中小企业评价办法（国科发政〔2017〕115号）",
          "url": "https://most.gov.cn/xxgk/xinxifenlei/fdzdgknr/fgzc/gfxwj/gfxwj2017/201705/t20170510_132709.html",
          "published": "2017-05-03",
          "authority": "科技部、财政部、国家税务总局"
        },
        "clause": "第六条（二）",
        "quote": "资产总额不超过2亿元。",
        "threshold": 20000,
        "unit": "万元",
        "period": "2025"
      },
      {
        "id": "industry",
        "title": "产品服务行业范围",
        "fields": [
          "allowed_industry"
        ],
        "op": "eq",
        "source": {
          "id": "national-sme",
          "title": "科技型中小企业评价办法（国科发政〔2017〕115号）",
          "url": "https://most.gov.cn/xxgk/xinxifenlei/fdzdgknr/fgzc/gfxwj/gfxwj2017/201705/t20170510_132709.html",
          "published": "2017-05-03",
          "authority": "科技部、财政部、国家税务总局"
        },
        "clause": "第六条（三）",
        "quote": "企业提供的产品和服务不属于国家规定的禁止、限制和淘汰类。",
        "expected": true
      },
      {
        "id": "integrity",
        "title": "上一年度及当年信用与事故条件",
        "fields": [
          "sme_compliance"
        ],
        "op": "eq",
        "source": {
          "id": "national-sme",
          "title": "科技型中小企业评价办法（国科发政〔2017〕115号）",
          "url": "https://most.gov.cn/xxgk/xinxifenlei/fdzdgknr/fgzc/gfxwj/gfxwj2017/201705/t20170510_132709.html",
          "published": "2017-05-03",
          "authority": "科技部、财政部、国家税务总局"
        },
        "clause": "第六条（四）",
        "quote": "企业在填报上一年及当年内未发生重大安全、重大质量事故和严重环境违法、科研严重失信行为，且企业未列入经营异常名录和严重违法失信企业名单。",
        "expected": true,
        "period": "2025-2026"
      },
      {
        "id": "innovation",
        "title": "创新积分或有效直通车条件",
        "fields": [
          "employees",
          "tech_staff",
          "rd_2025",
          "sales_2025",
          "cost_2025",
          "ip_class1",
          "ip_class2",
          "fast_track"
        ],
        "op": "sme_score",
        "source": {
          "id": "national-sme",
          "title": "科技型中小企业评价办法（国科发政〔2017〕115号）",
          "url": "https://most.gov.cn/xxgk/xinxifenlei/fdzdgknr/fgzc/gfxwj/gfxwj2017/201705/t20170510_132709.html",
          "published": "2017-05-03",
          "authority": "科技部、财政部、国家税务总局"
        },
        "clause": "第六条（五）、第七条、第八条",
        "quote": "综合评价所得分值不低于60分，且科技人员指标得分不得为0分。符合第六条（一）至（四）且满足第八条条件的企业可直接确认。",
        "period": "2025"
      }
    ]
